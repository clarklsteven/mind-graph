{
  "name": "mind-graph",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm --workspace=client run dev",
    "server": "npm --workspace=server run dev",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "test": "npm --workspaces run test",
    "test:coverage": "npm --workspaces run test:coverage",
    "lint": "npm --workspaces run lint",
    "verify": "npm run lint && npm run test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "client": "^0.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
